# Path to the Obsidian brain. Defaults to ./brain inside this repo.
# Point it elsewhere if the vault lives in its own private repo.
ARCANE_BRAIN=./brain

# Local Notion export of the Arcane Archives (HERALD's offline source).
ARCANE_ARCHIVES_EXPORT="/Users/leogray/Desktop/Arcane Archives/notion-export-clean/The Arcane Archives"

# Supabase — see docs/SUPABASE.md. The anon key is the only key the facility
# bundle ever reads (for the sync row); the service-role key is for the API
# functions and the tools (archives:sync, vault:sync, db:check) and is never
# bundled. The Vercel integration names them NEXT_PUBLIC_storage_SUPABASE_URL,
# NEXT_PUBLIC_storage_SUPABASE_PUBLISHABLE_KEY and storage_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=https://pjdzdfmnfuneumzqoijn.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The operator key: one secret, set here and in the Vercel project, pasted once
# into each browser (the DEVICE control in the bar). Every /api call needs it.
# Make it long and random: openssl rand -base64 32
ARCANE_OPERATOR_KEY=

# The model. Free: run Ollama on this machine (https://ollama.com), pull a
# model (ollama pull qwen3:14b) and set ARCANE_PROVIDER=ollama. Paid: set
# ANTHROPIC_API_KEY. With neither set to ollama, the key decides.
# ARCANE_PROVIDER=ollama
# ARCANE_MODEL=qwen3:14b
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=16384
# Missions (docs/MISSIONS.md) search the web through DuckDuckGo, or your own SearXNG:
# SEARXNG_URL=http://127.0.0.1:8888
# npm run dev runs the mission worker inside the API; ARCANE_WORKER=0 turns that off.
# ARCANE_WORKER=0

# Anthropic — HERALD (api/herald, herald:auto), Counsel, the Council, CIPHER's web search.
ANTHROPIC_API_KEY=
# HERALD_MODEL=claude-opus-5
# HERALD_EFFORT=high

# Local development only (never set on Vercel):
#   ARCANE_DB=memory   — the dev database: modules from data/archives, content in data/dev-db.json
#   HERALD_MOCK=1      — HERALD cuts the module's own sentences instead of calling the API
# `npm run dev:local` sets both.

# Notion, read-only — lets HERALD index the Archives without Leo's Mac.
# Create an internal integration, share the Arcane Archives page with it:
# https://www.notion.so/profile/integrations
NOTION_TOKEN=
# Pins the Archives root page. Without it the root is found by title.
ARCANE_ARCHIVES_NOTION_ID=
