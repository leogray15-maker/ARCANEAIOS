# Path to the Obsidian brain. Defaults to ./brain inside this repo.
# Point it elsewhere if the vault lives in its own private repo.
ARCANE_BRAIN=./brain

# Local Notion export of the Arcane Archives (HERALD's offline source).
ARCANE_ARCHIVES_EXPORT="/Users/leogray/Desktop/Arcane Archives/notion-export-clean/The Arcane Archives"

# Supabase — see docs/SUPABASE.md. The anon key is the only key the facility
# bundle ever reads (for the sync row); the service-role key is for the API
# functions and the tools (archives:sync, vault:sync, db:check) and is never
# bundled. The Vercel integration names them NEXT_PUBLIC_storage_SUPABASE_URL,
# NEXT_PUBLIC_storage_SUPABASE_PUBLISHABLE_KEY and storage_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=https://pjdzdfmnfuneumzqoijn.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The operator key: one secret, set here and in the Vercel project, pasted once
# into each browser (the DEVICE control in the bar). Every /api call needs it.
# Make it long and random: openssl rand -base64 32
ARCANE_OPERATOR_KEY=

# Anthropic — HERALD (api/herald, herald:auto), Counsel and the Council.
ANTHROPIC_API_KEY=
# HERALD_MODEL=claude-opus-5
# HERALD_EFFORT=high

# Local development only (never set on Vercel):
#   ARCANE_DB=memory   — the dev database: modules from data/archives, content in data/dev-db.json
#   HERALD_MOCK=1      — HERALD cuts the module's own sentences instead of calling the API
# `npm run dev:local` sets both.

# Notion, read-only — lets HERALD index the Archives without Leo's Mac.
# Create an internal integration, share the Arcane Archives page with it:
# https://www.notion.so/profile/integrations
NOTION_TOKEN=
# Pins the Archives root page. Without it the root is found by title.
ARCANE_ARCHIVES_NOTION_ID=

# ---------------------------------------------------------------- the AI layer
# packages/ai routes every model call. Keys stay on the server: none of these
# has a NEXT_PUBLIC_ or VITE_ prefix, and CI fails if one reaches the bundle.

# OpenRouter: the gateway for Claude, GPT, Grok, DeepSeek, Kimi, Qwen, Llama
# and the free models. https://openrouter.ai/settings/keys (starts sk-or-v1-).
OPENROUTER_API_KEY=
# Gemini, called directly so its free tier is used. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Set to "paid" only if billing is enabled on that AI Studio project; Gemini
# is then treated as a paid model, behind ALLOW_PAID_MODELS and the budget.
# GEMINI_BILLING=free
# Optional providers — each switches on when its key is present.
GROQ_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
# Nous Research (Hermes models), https://portal.nousresearch.com — paid credits.
NOUS_API_KEY=

# The paid-model gate. Anything but exactly "true" means paid models are never
# called, whatever an agent asks for.
ALLOW_PAID_MODELS=false
# The ceiling on paid model spend per calendar month, in pounds. Checked
# against the logged spend (model_usage) before every paid call. Unset or 0
# means no paid call is made at all.
MONTHLY_BUDGET_GBP=5

# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/tick.
# Also set it as a GitHub Actions secret if the Actions scheduler is used.
# openssl rand -base64 32
CRON_SECRET=

# The site's own URL, sent to OpenRouter as the referer for attribution.
# ARCANE_SITE_URL=https://arcaneaios.vercel.app
