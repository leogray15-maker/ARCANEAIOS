{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "npm run check && npm run facility:build",
  "outputDirectory": "apps/facility/dist",
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "includeFiles": ".claude/skills/herald/**",
      "maxDuration": 300
    }
  },
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Frame-Options", "value": "DENY" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
